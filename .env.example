APP_NAME="PC Center"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# true muestra las credenciales de prueba en el login. Ponlo en false en cualquier uso real.
APP_DEMO=true
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
LOG_CHANNEL=single
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pc_center
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
