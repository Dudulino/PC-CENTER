{
  "name": "pc-center/sistema-presupuestos",
  "description": "Prototipo academico PC Center: presupuestos mediante escaneo de productos",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "barryvdh/laravel-dompdf": "^3.1"
  },
  "require-dev": {
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}
  },
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "post-create-project-cmd": ["@php artisan key:generate --ansi"]
  },
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable",
  "prefer-stable": true
}
